{
  "name": "root",
  "private": true,
  "author": {
    "name": "Kevin Wang",
    "url": "https://thekevinwang.com"
  },
  "version": "0.0.0",
  "description": "React components transcribed from the Vercel design system.",
  "scripts": {
    "build:core-swc": "npm run build:swc --workspace=nextjs-components",
    "build:core-babel": "npm run build:babel --workspace=nextjs-components",
    "clean": "npm run clean --workspace=nextjs-components",
    "docs": "npm run dev --workspace=docs",
    "docs:plop": "npm run plop --workspace=docs",
    "test": "npm run test --workspace=nextjs-components -- --runInBand --watchman=false",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release": "changeset publish",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextjs-components/nextjs-components.git"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nextjs-components/nextjs-components/issues"
  },
  "homepage": "https://github.com/nextjs-components/nextjs-components#readme",
  "workspaces": [
    "packages/core",
    "packages/docs"
  ],
  "dependencies": {
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "hast-util-to-html": "^9.0.4",
    "hast-util-to-string": "^3.0.1",
    "html-to-jsx-transform": "^1.2.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-react": "^8.0.0",
    "rehype-stringify": "^10.0.1",
    "turbo": "^1.8.3",
    "unified": "^11.0.5"
  },
  "engines": {
    "node": "^22.12 || ^24 || >=26",
    "npm": ">=11.5.1"
  }
}
