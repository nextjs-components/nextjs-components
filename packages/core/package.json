{
  "name": "nextjs-components",
  "version": "6.2.0-rc.0",
  "author": {
    "name": "Kevin Wang",
    "url": "https://thekevinwang.com"
  },
  "description": "React components transcribed from the Vercel design system.",
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:styles": "tailwindcss -i ./styles/tailwind.css -o ./src/styles/utilities.css --minify",
    "dev:styles": "npm run build:styles -- --watch",
    "prepack": "npm run build:styles",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "publish:local": "npx yalc publish",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextjs-components/nextjs-components.git"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nextjs-components/nextjs-components/issues"
  },
  "homepage": "https://github.com/nextjs-components/nextjs-components#readme",
  "dependencies": {
    "@internationalized/date": "^3.6.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-portal": "^1.1.17",
    "clsx": "2.1.1",
    "next-themes": "^0.4.6",
    "react-aria": "^3.27.0",
    "react-stately": "^3.25.0",
    "react-use-measure": "2.1.1"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "14.4.3",
    "@types/jest": "29.1.1",
    "@types/react": "18.0.21",
    "@types/react-is": "17.0.3",
    "jest": "29.1.1",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "^29.1.2",
    "next": "15.1.3",
    "react-is": "19.0.0",
    "source-map-support": "0.5.21",
    "styled-jsx": "5.1.6",
    "tailwindcss": "^4.3.3",
    "ts-jest": "29.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "next": ">=15.x",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "styled-jsx": ">=5.x"
  }
